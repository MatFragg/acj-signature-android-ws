# =============================================================================
# ACJ Signature API - Environment variables example
# =============================================================================
# Copy this file to `.env` and fill the real values. NEVER commit `.env`.
# Spring Boot picks up env vars automatically (SPRING_DATASOURCE_URL, etc.)
# or placeholders like ${JWT_SECRET} are resolved from process env.
# =============================================================================

# ---- Profile ----------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# ---- Database (PostgreSQL 16) -----------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/android_ws
DB_USERNAME=android_ws
DB_PASSWORD=

# ---- JWT (HS512 requires >= 64 bytes / 512 bits of entropy) -----------------
# Generate: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
JWT_ISSUER=acj-signature-api

# ---- OTP --------------------------------------------------------------------
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_LENGTH=6

# ---- Mail (SMTP) ------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_OTP_SUBJECT=Codigo de Verificacion - ACJ Signature
MAIL_BRAND_NAME=ACJ Signature
MAIL_BASE_URL=http://localhost:8067
MAIL_HELP_URL=http://localhost:8067/help
MAIL_PRIVACY_URL=http://localhost:8067/privacy
MAIL_TERMS_URL=http://localhost:8067/terms

# ---- RENIEC (Decolecta) -----------------------------------------------------
RENIEC_API_URL=https://api.decolecta.com/v1/reniec/dni
RENIEC_API_TOKEN=
RENIEC_CONNECT_TIMEOUT_MS=5000
RENIEC_READ_TIMEOUT_MS=5000

# ---- CORS -------------------------------------------------------------------
# Comma-separated list for CORS_ALLOWED_ORIGINS
CORS_ALLOWED_ORIGINS=http://localhost:4200
CORS_ALLOW_CREDENTIALS=false

# ---- Rate Limiting (per-IP, in-memory Bucket4j) -----------------------------
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_HOUR=3
RATE_LIMIT_OTP_VERIFY_PER_MINUTE=5
RATE_LIMIT_FORGOT_PASSWORD_PER_HOUR=3

# ---- Bootstrap (dev only) ---------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=admin@test.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_USER_EMAIL=user@test.com
BOOTSTRAP_USER_PASSWORD=
